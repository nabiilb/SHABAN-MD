# Front-end configuration (Vite). Everything here ships to the browser — never put secrets in it.

# Base URL of the Laravel API including its /api prefix.
# In development the Vite dev server proxies /api to php artisan serve (API_PROXY_TARGET,
# default http://127.0.0.1:8000), so the default is fine.
# Production (https://lab.sooryoscan.com, served from the subdomain root): /api — npm run release sets it.
VITE_API_URL=/api

# URL path the app is served from: / (default; production at the subdomain root). Only a
# deployment under a URL sub-path (e.g. https://example.com/lab/) needs /lab/ here.
VITE_BASE_PATH=/

# true  = run against the in-browser mock backend (src/mocks) — no API or database needed
# false = send every request to VITE_API_URL (the Laravel API + MySQL)
VITE_USE_MOCKS=false

# Mock backend only: simulated network latency (ms) and session lifetime (minutes)
VITE_MOCK_LATENCY_MS=250
VITE_SESSION_TIMEOUT_MINUTES=480
