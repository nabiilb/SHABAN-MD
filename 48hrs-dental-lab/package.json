{
  "name": "48hrs-dental-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate --no-hints",
    "dev": "npm run dev -w @48hrs/web",
    "dev:web": "npm run dev -w @48hrs/web",
    "dev:api": "npm run dev -w @48hrs/api",
    "worker": "npm run worker -w @48hrs/api",
    "build": "npm run build -w @48hrs/web && npm run build -w @48hrs/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "dotenv": "^18.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8",
    "typescript-eslint": "^8.70.1"
  }
}
