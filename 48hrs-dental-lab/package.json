{
  "name": "48hrs-dental-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @48hrs/web",
    "build": "npm run build -w @48hrs/web",
    "release": "node scripts/build-release.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:api": "cd backend && php vendor/bin/phpunit",
    "test:e2e": "npm run e2e -w @48hrs/web",
    "contract:export": "npm run contract:export -w @48hrs/shared"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8",
    "typescript-eslint": "^8.70.1"
  }
}
