# ─────────────────────────────────────────────────────────────────────────────
# 48HRS Dental Lab — backend configuration for local development.
# Copy to .env (never commit .env) and replace every CHANGE_ME.
# Staging/production templates: deploy/staging.env.example, deploy/production.env.example
# The web app has its own public settings in apps/web/.env.example.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# PostgreSQL. The API, the worker and Prisma (migrate/seed) all use DATABASE_URL.
DATABASE_URL=postgresql://lab:CHANGE_ME@localhost:5432/dental_lab
# Disposable databases for automated tests — they are wiped on every run.
TEST_DATABASE_URL=postgresql://lab:CHANGE_ME@localhost:5432/dental_lab_test
E2E_DATABASE_URL=postgresql://lab:CHANGE_ME@localhost:5432/dental_lab_e2e

# HTTP
PORT=4000
# Browser origins allowed to call the API with cookies (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Number of reverse proxies in front of the API (0 when none).
TRUST_PROXY=0

# Sessions. Generate the secret with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_48_RANDOM_BYTES_BASE64
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_MINUTES=480
# Secure cookies need HTTPS; plain http://localhost needs false.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Sign-in protection: per-account lockout and per-IP limit (per 15 minutes).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT=100

# The lab's working day (due today, reports, dashboard periods).
LAB_TIMEZONE=Africa/Mogadishu

# Case files. Relative paths are resolved against apps/api.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=50

# Password-reset e-mails. "log" prints the link to the API log (development only).
APP_URL=http://localhost:5173
MAIL_TRANSPORT=log
MAIL_FROM=48HRS Dental Lab <no-reply@localhost>
SMTP_URL=

LOG_LEVEL=info
WORKER_INTERVAL_SECONDS=60

# Optional: serve the built web app from the API (single origin), e.g. ../web/dist
WEB_DIST_DIR=

# Seeding (npm run db:seed). demo = sample lab data for every role; base = catalogue,
# roles and settings only (plus the first Super Admin when SEED_ADMIN_* are set).
SEED_MODE=demo
SEED_USER_PASSWORD=CHANGE_ME_8plus_chars_with_digits1
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
