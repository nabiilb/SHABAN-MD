# Base URL of the backend API (e.g. Laravel: https://api.48hrs.lab/api/v1)
VITE_API_URL=http://localhost:8000/api/v1

# true  = use the in-browser mock API (src/mocks) — no backend needed
# false = send every request to VITE_API_URL
VITE_USE_MOCKS=true

# Convert request/response keys between camelCase (frontend) and snake_case (Laravel)
VITE_API_SNAKE_CASE=false

# Send cookies with API requests (Laravel Sanctum SPA auth)
VITE_API_WITH_CREDENTIALS=false

# Simulated network latency for the mock API, in milliseconds
VITE_MOCK_LATENCY_MS=250

# Minutes of inactivity/lifetime after which the session expires
VITE_SESSION_TIMEOUT_MINUTES=480
