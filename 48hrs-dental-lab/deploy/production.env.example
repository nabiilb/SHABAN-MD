# ─────────────────────────────────────────────────────────────────────────────
# 48HRS Dental Lab — PRODUCTION. Set these in the platform's secret store or a
# root-only file outside the repository. Never commit real values.
# The API refuses to start in production without Secure cookies, an allowed
# origin and SMTP.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=postgresql://lab_app:CHANGE_ME@db.internal:5432/dental_lab?sslmode=require
PORT=4000
CORS_ORIGINS=https://lab.example.com
TRUST_PROXY=1

JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_MINUTES=480
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT=100

LAB_TIMEZONE=Africa/Mogadishu
UPLOAD_DIR=/var/lib/48hrs/uploads
MAX_UPLOAD_MB=50

APP_URL=https://lab.example.com
MAIL_TRANSPORT=smtp
MAIL_FROM=48HRS Dental Lab <no-reply@lab.example.com>
SMTP_URL=smtps://USER:CHANGE_ME@smtp.example.com:465

LOG_LEVEL=info
WORKER_INTERVAL_SECONDS=60
# Serve the SPA from the API (single origin). Leave empty when a CDN/web server hosts apps/web/dist.
WEB_DIST_DIR=../web/dist

# First deployment only: npm run db:seed creates the catalogue, roles and this Super Admin.
SEED_MODE=base
SEED_ADMIN_EMAIL=admin@lab.example.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=CHANGE_ME_then_remove_this_line
