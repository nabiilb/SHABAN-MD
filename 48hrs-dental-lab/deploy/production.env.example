# ─────────────────────────────────────────────────────────────────────────────
# 48HRS Dental Lab — PRODUCTION on Hostinger (Laravel + MySQL): https://lab.sooryoscan.com
# The subdomain's document root is public_html/48hrs_lab (a folder on disk only —
# it is NOT part of any URL). Save this file as
# /home/u501147781/domains/sooryoscan.com/48hrs_lab_app/.env (outside public_html), chmod 600.
# Never commit real values. Replace every CHANGE_ME: the app refuses to boot in
# production with placeholders, a SESSION_PATH that does not match APP_URL, APP_DEBUG=true, http:// URLs,
# insecure cookies, the log mailer or a sync queue (php artisan lab:check-config).
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="48HRS Dental Lab"
APP_ENV=production
# php artisan key:generate --force   (writes it here)
APP_KEY=
APP_DEBUG=false
APP_URL=https://lab.sooryoscan.com
FRONTEND_URL=https://lab.sooryoscan.com

LAB_TIMEZONE=Africa/Mogadishu

# hPanel → Databases → MySQL: the database, user and password you created.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u501147781_dental_lab
DB_USERNAME=u501147781_lab
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_TTL_MINUTES=480
SESSION_LIFETIME=480
# The app is the whole subdomain: cookies for / (host-only: no SESSION_DOMAIN, so
# sooryoscan.com and its other subdomains never receive them).
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT=100
PASSWORD_RESET_RATE_LIMIT=10
API_RATE_LIMIT=600
# Only if the site is behind a proxy/CDN that sets X-Forwarded-* (e.g. Cloudflare): *
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=

# Case files: private, outside public_html. Default: 48hrs_lab_app/storage/app/private/cases
UPLOAD_DIR=
MAX_UPLOAD_MB=50

CACHE_STORE=database
# Mail and alerts are processed by the queue worker the scheduler runs (cron).
QUEUE_CONNECTION=database

# hPanel → Emails: an SMTP mailbox for password-reset e-mails.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@sooryoscan.com
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=no-reply@sooryoscan.com
MAIL_FROM_NAME="48HRS Dental Lab"

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
BCRYPT_ROUNDS=12

# Seeding is done once, with variables given on the command line (see README):
# they are not kept in this file.
