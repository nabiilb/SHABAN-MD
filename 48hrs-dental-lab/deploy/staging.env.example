# ─────────────────────────────────────────────────────────────────────────────
# 48HRS Dental Lab — STAGING. Same shape as production, separate database,
# secrets and domain. Demo data is allowed here for acceptance testing.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=postgresql://lab_staging:CHANGE_ME@db-staging.internal:5432/dental_lab_staging?sslmode=require
PORT=4000
CORS_ORIGINS=https://staging.lab.example.com
TRUST_PROXY=1

JWT_SECRET=CHANGE_ME_different_from_production
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_MINUTES=480
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT=300

LAB_TIMEZONE=Africa/Mogadishu
UPLOAD_DIR=/var/lib/48hrs-staging/uploads
MAX_UPLOAD_MB=50

APP_URL=https://staging.lab.example.com
MAIL_TRANSPORT=smtp
MAIL_FROM=48HRS Staging <no-reply@staging.lab.example.com>
SMTP_URL=smtp://USER:CHANGE_ME@smtp.example.com:587

LOG_LEVEL=debug
WORKER_INTERVAL_SECONDS=60
WEB_DIST_DIR=../web/dist

# Staging may load the demo dataset: SEED_MODE=demo ALLOW_DEMO_SEED=true npm run db:seed
SEED_MODE=demo
ALLOW_DEMO_SEED=true
SEED_USER_PASSWORD=CHANGE_ME_8plus_chars_with_digits1
