# /etc/systemd/system/48hrs-worker.service — systemctl enable --now 48hrs-worker
# Continuous deadline worker (one or more instances; alerts are never duplicated).
# Alternative for cron: npm run start:worker:once (exits non-zero when the pass fails).
[Unit]
Description=48HRS Dental Lab deadline worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=lab
WorkingDirectory=/srv/48hrs-dental-lab
EnvironmentFile=/etc/48hrs/api.env
ExecStart=/usr/bin/node apps/api/dist/worker.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
