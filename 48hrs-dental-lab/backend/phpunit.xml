<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Real php -S server and artisan processes; these commit to the test database. -->
        <testsuite name="Http">
            <directory>tests/Http</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <!-- A disposable database: every run wipes it. Override with TEST_DB_DATABASE. -->
        <env name="DB_DATABASE" value="dental_lab_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="database"/>
        <env name="SESSION_SECURE_COOKIE" value="false"/>
        <env name="LAB_TIMEZONE" value="Africa/Mogadishu"/>
        <env name="AUTH_RATE_LIMIT" value="1000"/>
        <env name="API_RATE_LIMIT" value="100000"/>
        <env name="PASSWORD_RESET_RATE_LIMIT" value="1000"/>
        <env name="MAX_UPLOAD_MB" value="1"/>
        <env name="UPLOAD_DIR" value="storage/framework/testing/cases"/>
        <env name="SESSION_TTL_MINUTES" value="480"/>
        <env name="SESSION_LIFETIME" value="480"/>
        <env name="LOGIN_MAX_ATTEMPTS" value="5"/>
        <env name="LOGIN_LOCK_MINUTES" value="15"/>
        <env name="FRONTEND_URL" value="http://localhost:5173"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
