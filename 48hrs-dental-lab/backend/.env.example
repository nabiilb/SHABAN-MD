# ─────────────────────────────────────────────────────────────────────────────
# 48HRS Dental Lab API (Laravel) — local development.
# Copy to backend/.env (never commit .env), then: php artisan key:generate
# Production (Hostinger): ../deploy/production.env.example
# Every CHANGE_ME must be replaced; the app refuses placeholder values.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="48HRS Dental Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Where the API is reached (php artisan serve).
APP_URL=http://127.0.0.1:8000
# The React app (password-reset links point here).
FRONTEND_URL=http://localhost:5173

# The lab's working day: "due today", reports, dashboard periods, case-number year.
LAB_TIMEZONE=Africa/Mogadishu

# MySQL 8 (utf8mb4). The test suite uses dental_lab_test (phpunit.xml) and the
# end-to-end run dental_lab_e2e — both are wiped on every run.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dental_lab
DB_USERNAME=lab
DB_PASSWORD=CHANGE_ME

# Sessions: database-backed, HTTP-only cookie. SESSION_TTL_MINUTES is the absolute
# end of a sign-in (activity never extends it); SESSION_LIFETIME the idle limit.
SESSION_DRIVER=database
SESSION_TTL_MINUTES=480
SESSION_LIFETIME=480
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Sign-in protection: per-account lockout; per-IP limits.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT=100
PASSWORD_RESET_RATE_LIMIT=10
API_RATE_LIMIT=600
# Reverse proxies whose X-Forwarded-* headers are trusted (comma-separated IPs, or * behind a CDN).
TRUSTED_PROXIES=
# Extra browser origins allowed to call the API with cookies (the app's own origin needs no entry).
CORS_ALLOWED_ORIGINS=

# Case files: a private folder outside any web root (relative paths are inside backend/).
UPLOAD_DIR=
MAX_UPLOAD_MB=50

CACHE_STORE=database
QUEUE_CONNECTION=database

# "log" writes password-reset e-mails (with the link) to storage/logs.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME="48HRS Dental Lab"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
BCRYPT_ROUNDS=12

# Seeding (php artisan db:seed) — see database/seeders/DatabaseSeeder.php.
# base: catalogue, roles, settings + the first Super Admin. demo: the demo lab (development only).
SEED_MODE=demo
SEED_USER_PASSWORD=CHANGE_ME
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
